{
  "name": "office-addin-taskpane-react",
  "version": "1.0.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane-React.git"
  },
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "config": {
    "dev_server_port": 3000
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:prod": "npm run build && npm run package",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "package": "npm run validate:prod && node scripts/create-package.js",
    "start": "npm run dev-server",
    "start:excel": "office-addin-debugging start manifest.json desktop --app excel",
    "start:powerpoint": "office-addin-debugging start manifest.json desktop --app powerpoint",
    "start:word": "office-addin-debugging start manifest.json desktop --app word",
    "start:api": "npm --prefix api start",
    "start:storage": "npm --prefix api run start:storage",
    "sideload:owa": "powershell -NoProfile -ExecutionPolicy Bypass -File ./sideload-owa.ps1",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "stop": "office-addin-debugging stop manifest.json",
    "validate": "office-addin-manifest validate manifest.json",
    "validate:prod": "office-addin-manifest validate dist/manifest.json && node scripts/validate-prod-manifest.js",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "@fluentui/react-combobox": "^9.17.7",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "@fluentui/react-tabster": "^9.26.18",
    "core-js": "^3.36.0",
    "es6-promise": "^4.2.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webpack": "^5.28.5",
    "acorn": "^8.11.3",
    "archiver": "^7.0.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint-plugin-office-addins": "^4.0.10",
    "eslint-plugin-react": "^7.28.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "office-addin-cli": "^2.0.10",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-lint": "^3.0.10",
    "office-addin-manifest": "^2.1.6",
    "office-addin-prettier-config": "^2.0.5",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ]
}
